#VRML_SIM R2025a utf8
# Five robots in a line, 10 cm apart: the radio reaches 15 cm, so only the next robot.

WorldInfo {
  basicTimeStep 32
}
Viewpoint {
  orientation 0 0 1 1.5708
  position 0.2 -0.5 0.1
}
Robot {
  translation 0.0 0 0
  name "source"
  controller "phyelds_gradient"
  children [
    Emitter {
      range 0.15
    }
    Receiver {
    }
    LED {
      name "led"
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.3 0.3 0.3
          }
          geometry Sphere {
            radius 0.02
          }
        }
      ]
      color [
        1 0.5 0
      ]
    }
  ]
}
